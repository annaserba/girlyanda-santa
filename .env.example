# --- Database (Postgres) ---
# Local dev (direct): point at a running Postgres.
DATABASE_URL=

# Used by docker-compose to provision the bundled Postgres service.
POSTGRES_USER="santa"
POSTGRES_PASSWORD=
POSTGRES_DB="santa"

# --- Better Auth ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Base URL for personal reveal links and the client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email of the user that should be auto-promoted to admin on signup.
# The very first registered user is also promoted automatically.
ADMIN_EMAIL=

# Corporate mail is prepared in the admin Рассылка tab (mailto/BCC).
# Sending is manual from the corporate mail client; no API keys are needed.
